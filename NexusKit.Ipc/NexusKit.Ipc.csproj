<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Platform Condition=" '$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' ">x64</Platform>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>NexusKit.Ipc</RootNamespace>
		<AssemblyName>NexusKit.Ipc</AssemblyName>
		<Description>Dalamud-tied IPC plumbing for NexusKit. Registry, naming conventions, JSON payload helpers for cross-plugin contracts.</Description>
		<IsPackable>true</IsPackable>
		<Deterministic>true</Deterministic>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591;MSB3277</NoWarn>
		<!-- Library, not a Dalamud plugin. Skip the manifest packager. -->
		<Use_DalamudPackager>false</Use_DalamudPackager>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\NexusKit.Core\NexusKit.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" />
		<None Include="docs\**\*.md" />
	</ItemGroup>
</Project>
