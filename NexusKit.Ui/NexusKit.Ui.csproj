<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Platform Condition=" '$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' ">x64</Platform>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>NexusKit.Ui</RootNamespace>
		<AssemblyName>NexusKit.Ui</AssemblyName>
		<Description>Dalamud-tied UI primitives for NexusKit: window manager, auto-settings UI, dialog helpers.</Description>
		<IsPackable>true</IsPackable>
		<Deterministic>true</Deterministic>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591;MSB3277;CS0419</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- NexusKit.Ui is a library (consumed by plugins), not a plugin itself.
		     Skip Dalamud's plugin packager so we don't need a manifest yaml. -->
		<Use_DalamudPackager>false</Use_DalamudPackager>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\NexusKit.Core\NexusKit.Core.csproj" />
		<ProjectReference Include="..\NexusKit.Persistence\NexusKit.Persistence.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Framework.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Framework.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Framework.de.resx">
			<DependentUpon>Framework.resx</DependentUpon>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Framework.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Framework.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" />
		<None Include="docs\**\*.md" />
	</ItemGroup>
</Project>
