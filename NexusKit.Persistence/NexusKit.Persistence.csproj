<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>NexusKit.Persistence</RootNamespace>
		<AssemblyName>NexusKit.Persistence</AssemblyName>
		<Description>EF Core + SQLite persistence for NexusKit. Auto-cancelling DbContext factory, per-module migrations, DB-maintenance host.</Description>
		<IsPackable>true</IsPackable>
		<Deterministic>true</Deterministic>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591</NoWarn>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
		<!-- Transitive-to-direct promotion to escape GHSA-2m69-gcr7-jv3q (high):
		     SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 bundles a vulnerable SQLite.
		     EF Core .Sqlite still pins bundle_e_sqlite3 2.1.11 as of 10.0.9, so
		     the floor has to be raised here. This package is the native SQLite
		     binary and declares no dependencies of its own, so lifting it alone
		     leaves SQLitePCLRaw.core/provider on 2.1.11 by design — that is the
		     intended upgrade path for a native-only patch. Drop this reference
		     once EF Core ships a bundle that already resolves >= 2.1.12. -->
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NexusKit.Core\NexusKit.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" />
		<None Include="docs\**\*.md" />
	</ItemGroup>
</Project>
