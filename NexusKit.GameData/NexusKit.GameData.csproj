<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Platform Condition=" '$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' ">x64</Platform>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>NexusKit.GameData</RootNamespace>
		<AssemblyName>NexusKit.GameData</AssemblyName>
		<Description>Dalamud-tied game-data lookups for NexusKit. Lumina sheets, encounter/content resolution, world helpers.</Description>
		<IsPackable>true</IsPackable>
		<Deterministic>true</Deterministic>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591;MSB3277</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Library, not a plugin: no manifest yaml needed. -->
		<Use_DalamudPackager>false</Use_DalamudPackager>
	</PropertyGroup>

	<ItemGroup>
		<!-- Only the abstraction: this project stays silent on the render path
		     (see DalamudPlayerMapMarker), but a hook that fails to install has
		     to say so — otherwise the feature is simply missing with no trace. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NexusKit.Core\NexusKit.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" />
		<None Include="docs\**\*.md" />
	</ItemGroup>
</Project>
